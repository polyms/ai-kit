{
  "name": "landing",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/landing/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/landing",
        "command": "pnpm run build"
      },
      "outputs": ["{projectRoot}/.output"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/landing",
        "command": "pnpm run dev"
      }
    }
  }
}
