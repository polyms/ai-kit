generator client {
  provider        = "prisma-client"
  output          = "./schema"
  engineType      = "client"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model KnowledgeArticle {
  id        String           @id
  slug      String           @unique
  title     String
  summary   String           @db.Text
  intent    String
  axisTags  String[]
  checklist String[]
  status    String           @default("published")
  createdAt DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @db.Timestamptz(3)
  chunks    KnowledgeChunk[]

  @@index([status])
  @@index([intent])
  @@map("knowledge_articles")
}

/// Knowledge chunk — atomic retrieval unit (embed + rank target) for hybrid search.
model KnowledgeChunk {
  id        String           @id
  slug      String           @unique
  articleId String
  article   KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  intent    String
  chunkType String
  title     String
  body      String           @db.Text
  axisTags  String[]

  // incident-specific structured fields
  symptom        String?  @db.Text
  cause          String[]
  fix            String[]
  verify         String[]
  triggerPhrases String[]

  // config-specific metadata
  artifactFilename String?
  artifactType     String?

  // checklist-specific
  checklistItems String[]

  // auto-sub-chunking (prose over threshold at publish)
  parentChunkId String?
  parentChunk   KnowledgeChunk?  @relation("KnowledgeChunkParts", fields: [parentChunkId], references: [id], onDelete: Cascade)
  subChunks     KnowledgeChunk[] @relation("KnowledgeChunkParts")
  partIndex     Int?

  /// Display + agent reading order within the parent article (lower = earlier).
  sortOrder Int @default(0)

  /// pgvector column — populated via raw SQL (Unsupported type is not writable through Prisma Client).
  embedding Unsupported("vector(1536)")?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([articleId])
  @@index([articleId, sortOrder])
  @@index([intent])
  @@index([parentChunkId])
  @@map("knowledge_chunks")
}
