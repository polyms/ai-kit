# Supabase Postgres — pooled connection (port 6543) for app runtime
DATABASE_URL="postgresql://postgres:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection (port 5432) for Prisma migrations — Settings → Database → Direct connection
DIRECT_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres"

# Ops CMS (Phase 2) — OIDC via polyms.dev + session cookie
OIDC_CLIENT_ID="ai-kit-ops-local"
OIDC_CLIENT_SECRET="from-polyms-dev-oauth-app"
# Optional — defaults to https://polyms.dev
# OIDC_ISSUER="https://polyms.dev"
# Optional — defaults to {origin}/api/ops/auth/callback
# OIDC_REDIRECT_URI="http://localhost:6300/api/ops/auth/callback"
OPS_SESSION_SECRET="change-me-in-production"
OPS_DEV_BYPASS="true"
