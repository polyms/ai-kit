    "@types/react": "~19.2.17",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "~6.0.3",
    "nitro": "3.0.260610-beta",
    "nx": "23.0.1",
    "prettier": "~3.9.4",
