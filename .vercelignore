# Monorepo — exclude paths outside the landing app from Vercel upload
# (mirrors ui-kit vercel.json monorepo pattern; speeds deploys when root = apps/landing)

# Other apps / demos (root-only — avoid matching apps/landing/src/routes/skills/)
/demo/

# Repo skills/agents source (not runtime — overlay is bundled in landing)
/skills/
/agents/
/.cursor/

# Docs and contributor content
/docs/
*.md
!apps/landing/**/*.md

# CI for GitHub Pages (separate from Vercel)
.github/

# Local / tooling
.git/
.nx/
.pnpm-store/
node_modules/
**/.DS_Store
